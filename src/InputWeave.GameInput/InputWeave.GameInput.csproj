<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0;net10.0</TargetFrameworks>
    <AssemblyName>InputWeave.GameInput</AssemblyName>
    <RootNamespace>InputWeave.GameInput</RootNamespace>
    <Description>Microsoft GameInput 的 C# 分層包裝程式庫。</Description>
    <PackageId>InputWeave.GameInput</PackageId>
    <Version>0.0.1</Version>
    <Authors>InputWeave contributors</Authors>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/rubujo/InputWeave.GameInput</RepositoryUrl>
    <PackageProjectUrl>https://github.com/rubujo/InputWeave.GameInput</PackageProjectUrl>
    <PackageTags>gameinput;windows;input;gamepad;controller;xbox;xinput;directinput;force-feedback;haptics</PackageTags>
    <PackageLicenseExpression>CC0-1.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
    <!-- pack 時比對相容 TFM（net8.0 與 net10.0）的公開 API 與套件結構是否一致。 -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.GameInput" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net48'" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Compile Remove="**\*.Net.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != '' and '$(TargetFramework)' != 'net48'">
    <Compile Remove="**\*.NetFramework.cs" />
    <Compile Remove="**\*.NetFramework.g.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
